package com.thomsonreuters.cpp.cps.transformation.filters.sophia;

import org.xml.sax.Attributes;
import org.xml.sax.SAXException;
import org.xml.sax.helpers.AttributesImpl;


import com.thomson.west.wlnv.framework.filters.BaseFilter;
import com.thomson.west.wlnv.framework.filters.FilterChain;
import com.thomson.west.wlnv.framework.util.filters.Context;

public class AddingPTagFilter extends BaseFilter{

	private int listItemCount = 0;
	private int listCount = 0;
	private boolean listFlag = false;
	public static final String PROPERTY_ELEMENT_NAME = "element_name";
	public static final String PROPERTY_INSIDE_ELEMENT_NAME = "inside_element_name";
	
	

	@Override
	protected void init() {
		//setRecognizedProperty("outside_element_names", false,com.thomson.west.wlnv.framework.filters.BaseFilter.PROPERTY_TYPES.SET);

	}

	@Override
	public void reset() {
		//super.resetInScope();

	}

	@Override
	public void startElement(String uri, String localName, String qName,
			Attributes atts) throws SAXException {
		if(isInScope()){
			if(localName.equalsIgnoreCase("list")) {
				listCount++;
				listFlag = true;
				super.startElement(uri, localName, qName, atts);
			} else if(localName.equalsIgnoreCase("listItem")) {
				listItemCount++;
				super.startElement(uri, localName, qName, atts);
				super.startElement(uri, "p", "p", new AttributesImpl());
			} 
			else {
				super.startElement(uri, localName, qName, atts);
			}
			}
		else {
				super.startElement(uri, localName, qName, atts);
			}
		
	}

	@Override
	public void endElement(String uri, String localName, String qName)
	throws SAXException {
		if(isInScope()){
			if(localName.equals("list")) {
				listCount--;
				listFlag = false;
				super.endElement(uri, localName, qName);
			}else if(localName.equalsIgnoreCase("listItem")) {
				listItemCount--;
				super.endElement(uri, "p", "p");
				super.endElement(uri, localName, qName);
			} else {
				super.endElement(uri, localName, qName);
			}
			}
		else {
				super.endElement(uri, localName, qName);
			}
		
	}
	@Override
	public void characters(char[] ch, int start, int length)
	throws SAXException {
		super.characters(ch, start, length);
	}
}
